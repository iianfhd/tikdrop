# Password required to use TikDrop. Set a unique secret of at least 16 characters in .env.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# TIKDROP_ACCESS_PASSWORD=

# Batas ukuran tiap file video/audio (MB)
TIKDROP_MAX_FILE_SIZE_MB=500

# Batas durasi video; MP3 tidak dibatasi oleh pengaturan ini (detik)
TIKDROP_MAX_DURATION_SECONDS=600

# File hasil download akan dihapus otomatis setelah beberapa jam
TIKDROP_FILE_TTL_HOURS=6

# Maksimal proses download bersamaan
TIKDROP_MAX_CONCURRENT_DOWNLOADS=2

# Timeout koneksi ke TikTok (detik)
TIKDROP_SOCKET_TIMEOUT=30

# Direktori opsional; jika dikosongkan memakai folder bawaan proyek
# TIKDROP_DOWNLOAD_DIR=
# TIKDROP_TEMP_DIR=
